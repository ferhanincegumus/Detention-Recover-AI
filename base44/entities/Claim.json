{
  "name": "Claim",
  "description": "A detention/layover/TONU recovery claim against a broker.",
  "rls": { "ownerField": "ownerId", "softDeleteField": "deletedAt" },
  "indexes": [
    { "fields": ["ownerId", "status"] },
    { "fields": ["brokerId"] },
    { "fields": ["loadId"] },
    { "fields": ["claimNumber"], "unique": true }
  ],
  "schema": {
    "type": "object",
    "required": ["claimNumber", "loadId", "brokerName", "chargeType", "status", "claimedAmount", "ownerId"],
    "properties": {
      "claimNumber": { "type": "string" },
      "loadId": { "type": "string" },
      "loadReference": { "type": "string" },
      "brokerId": { "type": "string" },
      "brokerName": { "type": "string" },
      "customerName": { "type": "string" },
      "customerPhone": { "type": "string" },
      "chargeType": { "type": "string", "enum": ["detention", "layover", "tonu", "accessorial"] },
      "status": {
        "type": "string",
        "enum": ["draft", "sent", "broker_replied", "negotiating", "settlement_offered", "approved", "paid", "denied", "closed"]
      },
      "claimedAmount": { "type": "number" },
      "recoveredAmount": { "type": "number", "default": 0 },
      "settlementOffer": { "type": ["number", "null"] },
      "commissionRate": { "type": "number" },
      "commissionAmount": { "type": "number", "default": 0 },
      "carrierPayout": { "type": "number", "default": 0 },
      "sentAt": { "type": ["string", "null"], "format": "date-time" },
      "firstReplyAt": { "type": ["string", "null"], "format": "date-time" },
      "resolvedAt": { "type": ["string", "null"], "format": "date-time" },
      "paidAt": { "type": ["string", "null"], "format": "date-time" },
      "daysToRecover": { "type": ["number", "null"] },
      "recoveryProbability": { "type": "number", "minimum": 0, "maximum": 100 },
      "predictedPaymentDate": { "type": ["string", "null"], "format": "date-time" },
      "timeline": { "type": "array", "items": { "type": "object" } },
      "evidenceIds": { "type": "array", "items": { "type": "string" } },
      "claimLetter": { "type": "string" },
      "tags": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": "string" },
      "archived": { "type": "boolean", "default": false },
      "ownerId": { "type": "string" },
      "deletedAt": { "type": ["string", "null"], "format": "date-time" }
    }
  }
}

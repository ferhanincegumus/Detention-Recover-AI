{
  "name": "Broker",
  "description": "A freight broker with aggregated recovery intelligence.",
  "rls": { "ownerField": "ownerId", "softDeleteField": "deletedAt" },
  "indexes": [{ "fields": ["ownerId"] }, { "fields": ["name"] }],
  "schema": {
    "type": "object",
    "required": ["name", "ownerId"],
    "properties": {
      "name": { "type": "string" },
      "mcNumber": { "type": "string" },
      "email": { "type": "string" },
      "phone": { "type": "string" },
      "billingEmail": { "type": "string" },
      "address": { "type": "string" },
      "notes": { "type": "string" },
      "intel": {
        "type": "object",
        "properties": {
          "totalClaims": { "type": "number" },
          "recoveredAmount": { "type": "number" },
          "pendingAmount": { "type": "number" },
          "recoveryRate": { "type": "number" },
          "avgPaymentDays": { "type": "number" },
          "avgReplyHours": { "type": "number" },
          "delayScore": { "type": "number" },
          "riskScore": { "type": "number" },
          "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
          "aiSuggestion": { "type": "string" }
        }
      },
      "ownerId": { "type": "string" },
      "deletedAt": { "type": ["string", "null"], "format": "date-time" }
    }
  }
}

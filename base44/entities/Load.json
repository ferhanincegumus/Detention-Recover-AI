{
  "name": "Load",
  "description": "A freight load with stops, timestamps, and computed detention.",
  "rls": { "ownerField": "ownerId", "softDeleteField": "deletedAt" },
  "indexes": [
    { "fields": ["ownerId"] },
    { "fields": ["brokerId"] },
    { "fields": ["referenceNumber"] }
  ],
  "schema": {
    "type": "object",
    "required": ["referenceNumber", "brokerName", "freeHours", "ratePerHour", "ownerId"],
    "properties": {
      "referenceNumber": { "type": "string" },
      "brokerId": { "type": "string" },
      "brokerName": { "type": "string" },
      "customerName": { "type": "string" },
      "customerPhone": { "type": "string" },
      "driverName": { "type": "string" },
      "freeHours": { "type": "number" },
      "ratePerHour": { "type": "number" },
      "stops": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["pickup", "delivery"] },
            "sequence": { "type": "number" },
            "facilityName": { "type": "string" },
            "address": { "type": "string" },
            "appointmentAt": { "type": "string", "format": "date-time" },
            "arrivedAt": { "type": "string", "format": "date-time" },
            "departedAt": { "type": "string", "format": "date-time" }
          }
        }
      },
      "billableDetentionHours": { "type": "number", "default": 0 },
      "detentionAmount": { "type": "number", "default": 0 },
      "documents": {
        "type": "object",
        "properties": {
          "hasRateConfirmation": { "type": "boolean" },
          "hasBol": { "type": "boolean" },
          "hasPod": { "type": "boolean" },
          "hasTimestamps": { "type": "boolean" }
        }
      },
      "riskScore": { "type": "number" },
      "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
      "missingDocuments": { "type": "array", "items": { "type": "string" } },
      "rateConfirmationFileId": { "type": "string" },
      "notes": { "type": "string" },
      "claimId": { "type": ["string", "null"] },
      "ownerId": { "type": "string" },
      "deletedAt": { "type": ["string", "null"], "format": "date-time" }
    }
  }
}

# Detention Recover AI — environment configuration
# Copy to .env.local and fill in as needed.

# Public app URL (used for canonical links / SEO / auth redirects)
VITE_APP_URL=https://detentionrecover.ai

# Data backend: "mock" (default, fully functional demo, no services needed)
# or "supabase" (free Postgres + Auth + Edge Functions).
VITE_DATA_BACKEND=mock

# ── Supabase (only when VITE_DATA_BACKEND=supabase) ──────────────────────────
# From Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional — defaults to <project-url>/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=

# ── Feature flags ────────────────────────────────────────────────────────────
# Disable public registration after deployment (single-admin product)
VITE_ENABLE_REGISTRATION=true
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_MAGIC_LINK=true
# SMS/WhatsApp is disabled for now — email-only via Resend
VITE_ENABLE_SMS=false

# Support contact (shown on landing/footer)
VITE_SUPPORT_EMAIL=recover@detentionrecover.ai
VITE_SUPPORT_PHONE=+18885551234

# ── Server-side secrets (set in Supabase, NOT here) ──────────────────────────
# RESEND_API_KEY           — Resend outbound email
# INBOUND_WEBHOOK_SECRET   — shared secret for the resend-inbound webhook
# ADMIN_USER_ID            — the admin's Supabase auth user id (public-lead-intake)

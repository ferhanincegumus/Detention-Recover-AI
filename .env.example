# Detention Recover AI — environment configuration
# Copy to .env.local and fill in as needed. All values are optional in mock mode.

# Public app URL (used for canonical links / SEO)
VITE_APP_URL=https://detentionrecover.ai

# Data backend: "mock" (default, fully functional demo) or "base44"
VITE_DATA_BACKEND=mock

# Base44 (required only when VITE_DATA_BACKEND=base44)
VITE_BASE44_APP_ID=
VITE_BASE44_API_URL=https://app.base44.com

# Feature flags
# Disable public registration after deployment (single-admin product)
VITE_ENABLE_REGISTRATION=true
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_MAGIC_LINK=true

# Support contact (shown on landing/footer)
VITE_SUPPORT_EMAIL=recover@detentionrecover.ai
VITE_SUPPORT_PHONE=+18885551234
